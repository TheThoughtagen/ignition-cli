// Gateway helpers — scaffolded by `ign e2e init`.
//
// Thin wrappers over the CLI's own WebDev testing routes, so a browser
// test can arrange gateway state (write a tag, run a script, wait for a
// value) without leaving the test file.
//
// Every call POSTs JSON to
//   ${IGNITION_URL}/system/webdev/__IGN_PROJECT__/testing/tags
// with the API token in X-Ignition-API-Token, using Node's built-in
// fetch. No HTTP dependency is added: three fetch calls do not justify
// a transitive HTTP stack.

const GATEWAY_URL = process.env.IGNITION_URL || '__IGN_GATEWAY_URL__';
const TOKEN = process.env.IGNITION_TOKEN || '';
const TAGS_ROUTE = `${GATEWAY_URL}/system/webdev/__IGN_PROJECT__/testing/tags`;

/**
 * THE localhost guard — duplicated verbatim in playwright.config.mjs.
 * See that file's comment for why the duplication is deliberate and
 * how the two copies are kept in agreement.
 */
function isLocalGateway(url) {
  let host;
  try {
    host = new URL(url).hostname;
  } catch {
    return false;
  }
  const loopback = host === 'localhost' || host === '127.0.0.1' || host === '::1';
  return loopback || process.env.IGNITION_ALLOW_INSECURE_LOCAL === 'true';
}

// TLS relaxation, gated to loopback (or an explicit opt-in). Announced
// once on stderr so it can never happen quietly — a silent downgrade of
// certificate checking is exactly the kind of thing that survives into
// a CI job pointed at a real gateway.
if (isLocalGateway(GATEWAY_URL)) {
  process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';
  process.stderr.write(
    `[ign e2e] TLS certificate verification disabled for local gateway ` +
      `${new URL(GATEWAY_URL).host}. For a remote gateway behind a private CA, ` +
      `set NODE_EXTRA_CA_CERTS instead.\n`,
  );
}

async function postTags(body) {
  const response = await fetch(TAGS_ROUTE, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Ignition-API-Token': TOKEN,
    },
    body: JSON.stringify(body),
  });
  const text = await response.text();
  if (!response.ok) {
    throw new Error(
      `gateway testing/tags answered HTTP ${response.status}: ${text.slice(0, 400)}\n` +
        `Is the bundle deployed? Run: ign e2e doctor --project __IGN_PROJECT__`,
    );
  }
  try {
    return JSON.parse(text);
  } catch (err) {
    throw new Error(`gateway testing/tags returned non-JSON: ${text.slice(0, 400)}`);
  }
}

/** Read tag values. `paths` is an array of full tag paths. */
export async function readTags(paths) {
  return postTags({ action: 'read', paths });
}

/**
 * Write tag values. `writes` is an array of `{path, value}` objects.
 */
export async function writeTags(writes) {
  return postTags({ action: 'write', writes });
}

/** Run a gateway-side script by path, with optional args. */
export async function runScript(path, args = {}) {
  return postTags({ action: 'script', path, args });
}

/**
 * Poll `readTags([path])` until `predicate(value)` holds, or the
 * deadline passes. Throws naming the tag path and the LAST value seen —
 * "timed out" without the observed value is the timeout message that
 * teaches you nothing.
 */
export async function waitForTag(path, predicate, timeoutMs = 30000, pollMs = 500) {
  const deadline = Date.now() + timeoutMs;
  let last;
  while (Date.now() < deadline) {
    const answer = await readTags([path]);
    const row = Array.isArray(answer.values) ? answer.values[0] : undefined;
    last = row && 'value' in row ? row.value : row;
    if (predicate(last)) {
      return last;
    }
    await new Promise((resolve) => setTimeout(resolve, pollMs));
  }
  throw new Error(
    `waitForTag timed out after ${timeoutMs}ms for ${path} — last value seen: ${JSON.stringify(last)}`,
  );
}
